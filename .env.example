# Database (PostgreSQL)
# Local:
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"
# AWS RDS:
#   Replace RDS_ENDPOINT, USER, PASSWORD, and DATABASE with your RDS instance details.
#   Add &sslmode=require for production.
DATABASE_URL="postgresql://glimps_app_user:YOUR_PASSWORD@RDS_ENDPOINT:5432/glimps_app_db?schema=public"

# S3 uploads (presigned PUT). Bucket stays private – no ACLs (AWS best practice).
# Viewing images (choose one):
#   A) CloudFront + OAC (recommended): create a distribution with Origin Access Control,
#      allow only CloudFront to read from S3. Set S3_PUBLIC_BASE_URL to your CloudFront URL.
#   B) Presigned GET: leave S3_PUBLIC_BASE_URL unset. Stored URLs point to /api/upload/signed?key=...
#      which redirects to a short-lived signed S3 URL (1h). No CloudFront needed.
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="us-east-1"
S3_BUCKET="your-bucket-name"
# Optional: set to CloudFront (or custom domain) URL for direct public viewing. If unset, viewing uses /api/upload/signed with opaque tokens.
# S3_PUBLIC_BASE_URL="https://d1234567890.cloudfront.net"

# Required for secure view URLs: opaque tokens so image paths/keys are never exposed to the browser. Min 16 chars.
UPLOAD_TOKEN_SECRET="your-32-char-or-longer-secret-here"

# People in media uses Amazon Rekognition (DetectFaces + CompareFaces) with AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_REGION. FACE_PROVIDER does not select Rekognition.
# local/http only applies to an unused hash-embedding helper. Do not set http unless that helper is wired.
# AWS_API_KEY is not read by this app.
FACE_PROVIDER="local"
# FACE_SERVICE_URL="https://your-insightface-host.example.com/faces"
FACE_SERVICE_TOKEN="replace-with-the-same-token-the-face-service-checks"
FACE_SERVICE_TIMEOUT_MS="20000"
# Must stay 128 until a new migration changes the vector column.
FACE_EMBEDDING_DIM="128"
FACE_MATCH_MIN_SIMILARITY="0.6"
# Profile photo changes use Amazon Rekognition CompareFaces (0-100) with the existing AWS keys.
PROFILE_FACE_MIN_SIMILARITY="95"
# Later photos of the same person (new background or style). Gallery CompareFaces stays FACE_REKOGNITION_MIN_SIMILARITY.
PROFILE_FACE_UPDATE_MIN_SIMILARITY="90"
# Gallery CompareFaces threshold (0-100). Separate from PROFILE_FACE_MIN_SIMILARITY. 90–95 cuts graphic false positives.
FACE_REKOGNITION_MIN_SIMILARITY="90"
FACE_DETECT_MIN_CONFIDENCE="90"
FACE_COMPARE_PAGE="8"
FACE_WORKER_TIME_BUDGET_MS="20000"
FACE_MAX_ATTEMPTS="3"
FACE_WORKER_BATCH="2"
# Required for a manual worker and accepted by POST /api/internal/media/process.
FACE_WORKER_SECRET="replace-with-a-long-random-string"
# Vercel Cron sends this as Authorization: Bearer. Set the same value in the Vercel project.
CRON_SECRET="replace-with-a-long-random-string"
# Direct Postgres URL for prisma migrate deploy when DATABASE_URL is pooled.
# DIRECT_URL="postgresql://USER:PASSWORD@db.prisma.io:5432/DATABASE?sslmode=require"
# Local worker default. On Vercel set this to the deployed app URL.
APP_BASE_URL="http://localhost:3000"
# HTTPS origin encoded in event QR / Copy link. Do not use APP_BASE_URL for this (that can be localhost).
APP_PUBLIC_URL="https://glimpse-admin-ecru.vercel.app"
# Replace the store URLs when the apps are listed. Package, bundle, team, and cert are for deep links.
ANDROID_PACKAGE_NAME="com.creatortech.uniglim"
ANDROID_PLAY_STORE_URL="https://play.google.com/store/apps/details?id=com.creatortech.uniglim"
ANDROID_SHA256_CERT_FINGERPRINTS=""
IOS_BUNDLE_ID="app.glimps"
IOS_TEAM_ID=""
IOS_APP_STORE_URL="https://apps.apple.com/app/id0000000000"
APP_URL_SCHEME="glimps"

# ==============================================================================
# AWS SES (Amazon Simple Email Service - Email OTP Delivery)
# ==============================================================================
# Verified sender identity in SES. Must be a verified email address or domain.
AWS_SES_FROM_EMAIL="noreply@glimpseapp.com"
# Optional display name for the sender
AWS_SES_FROM_NAME="Glimpse Verification"
# Optional SES configuration set for tracking delivery metrics and reputation
AWS_SES_CONFIGURATION_SET=""
# Set to "true" if the AWS account is in SES Sandbox (destination emails must be verified in SES console).
# Set to "false" once SES Production Access has been granted by AWS.
AWS_SES_SANDBOX="true"

# ==============================================================================
# AWS End User Messaging SMS (Pinpoint SMS Voice v2 - International SMS OTP Delivery)
# ==============================================================================
# Set to "true" to enable SMS delivery. If "false", SMS OTP requests will be rejected.
AWS_SMS_ENABLED="true"
# Alphanumeric Sender ID (supported in countries like UK, parts of Europe, Asia, Africa). Max 11 characters.
AWS_SMS_SENDER_ID="GLIMPSE"
# Dedicated phone number (10DLC, toll-free, short code) or pool ARN from AWS End User Messaging SMS console.
# Required in countries like the US/Canada. Leave empty if using pool ID or sender ID alone.
AWS_SMS_ORIGINATION_IDENTITY=""
# Phone pool ID or pool ARN in AWS End User Messaging SMS
AWS_SMS_POOL_ID=""
# Set to "true" if the AWS account is in SMS Sandbox (destination phones must be verified in AWS console).
# Set to "false" once SMS Production Access has been granted by AWS.
AWS_SMS_SANDBOX="true"

# India DLT Support (Optional: required for sending transactional SMS to Indian numbers +91)
# Registered Principal Entity ID from the DLT portal (e.g. Vilpower / JIO / Airtel)
AWS_SMS_DLT_ENTITY_ID=""
# Registered Content Template ID approved for the OTP message on DLT
AWS_SMS_DLT_TEMPLATE_ID=""

# ==============================================================================
# OTP Security and Lifecycle Configuration
# ==============================================================================
# Number of digits for the OTP (default: 6)
OTP_LENGTH="6"
# Validity period for the OTP in minutes (default: 5)
OTP_EXPIRY_MINUTES="5"
# Maximum incorrect verification attempts allowed before the OTP is invalidated (default: 5)
OTP_MAX_ATTEMPTS="5"
# Minimum cooldown period in seconds before a user can request a new OTP (default: 60)
OTP_RESEND_COOLDOWN_SECONDS="60"
# Secret key used for cryptographic HMAC-SHA256 hashing of OTPs in the database. Min 32 characters.
OTP_HASH_SECRET="replace-with-a-64-character-or-longer-cryptographic-secret"
# Set to "true" ONLY in local testing/staging environments to return the OTP in the API response.
# MUST be set to "false" in production.
OTP_ALLOW_TEST_MODE="false"
