model happening_photos {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  happening_id      String            @db.Uuid
  image_url         String
  media_type        String            @default("image") @db.VarChar(10)
  alt_text          String?           @db.VarChar(255)
  sort_order        Int?              @default(0)
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  current_happening current_happening @relation(fields: [happening_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([happening_id, sort_order], map: "idx_happening_photos_happening_id")
}

model user_devices {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String      @db.Uuid
  device_type  device_type
  device_id    String      @db.VarChar(255)
  is_active    Boolean?    @default(true)
  last_seen_at DateTime?   @db.Timestamptz(6)
  created_at   DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?   @default(now()) @db.Timestamptz(6)
  users        users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_devices_user")

  @@unique([user_id, device_id])
  @@index([device_type], map: "idx_user_devices_device_type")
  @@index([user_id], map: "idx_user_devices_user_id")
}

/// A user's favorite item within one event. Exactly one target column is set, matching item_type
/// (enforced by the user_favorites_target_check constraint).
model user_favorites {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String           @db.Uuid
  event_id           String           @db.Uuid
  item_type          String           @db.VarChar(20)
  event_day_media_id String?          @db.Uuid
  post_id            String?          @db.Uuid
  created_at         DateTime?        @default(now()) @db.Timestamptz(6)
  users              users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_favorites_user")
  events             events           @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_favorites_event")
  event_day_media    event_day_media? @relation(fields: [event_day_media_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_favorites_day_media")
  posts              posts?           @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_favorites_post")

  @@unique([user_id, event_id, event_day_media_id], map: "unique_user_favorite_day_media")
  @@unique([user_id, event_id, post_id], map: "unique_user_favorite_post")
  @@index([user_id, event_id, created_at(sort: Desc)], map: "idx_user_favorites_user_event_created")
  @@index([event_day_media_id], map: "idx_user_favorites_day_media")
  @@index([post_id], map: "idx_user_favorites_post")
}

enum comment_status {
  active
  deleted
}

enum media_type {
  image
  video
}

/// Photographer gallery row or user post media, linked to one event for face search.
model media_assets {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id           String    @db.Uuid
  source             String    @db.VarChar(20)
  media_type         media_type
  storage_key        String
  media_url          String
  content_sha256     String    @db.VarChar(64)
  idempotency_key    String?   @db.VarChar(120)
  event_day_media_id String?   @unique @db.Uuid
  post_media_id      String?   @unique @db.Uuid
  uploaded_by        String?   @db.Uuid
  processing_status  String    @default("pending") @db.VarChar(20)
  face_count         Int       @default(0)
  attempt_count      Int       @default(0)
  last_error         String?
  processed_at       DateTime? @db.Timestamptz(6)
  next_retry_at      DateTime? @db.Timestamptz(6)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
  events             events    @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  event_day_media    event_day_media? @relation(fields: [event_day_media_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  post_media         post_media?      @relation(fields: [post_media_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users              users?           @relation(fields: [uploaded_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  media_faces        media_faces[]
  media_matches      media_matches[]

  @@unique([event_id, content_sha256], map: "media_assets_event_hash_key")
  @@unique([event_id, idempotency_key], map: "media_assets_event_idempotency_key")
  @@index([event_id, processing_status], map: "idx_media_assets_event_status")
  @@index([processing_status, next_retry_at], map: "idx_media_assets_queue")
}

/// One detected face. The embedding column is written with raw SQL and is never selected by APIs.
model media_faces {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  media_asset_id String       @db.Uuid
  face_index     Int
  confidence     Float
  box            Json
  embedding      Unsupported("vector(128)")
  created_at     DateTime?    @default(now()) @db.Timestamptz(6)
  media_assets   media_assets @relation(fields: [media_asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  media_matches  media_matches[]

  @@unique([media_asset_id, face_index], map: "media_faces_asset_index_key")
  @@index([media_asset_id], map: "idx_media_faces_asset")
}

/// One consented face reference per user. Embedding is never returned by APIs.
model user_face_references {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @unique @db.Uuid
  consent         Boolean   @default(false)
  consent_version String    @default("v1") @db.VarChar(20)
  consented_at    DateTime? @db.Timestamptz(6)
  revoked_at      DateTime? @db.Timestamptz(6)
  storage_key       String?
  content_sha256    String?   @db.VarChar(64)
  processing_status String    @default("pending") @db.VarChar(20)
  attempt_count     Int       @default(0)
  last_error        String?
  next_retry_at     DateTime? @db.Timestamptz(6)
  embedding         Unsupported("vector(128)")?
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model media_matches {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  media_asset_id String       @db.Uuid
  media_face_id  String       @db.Uuid
  user_id        String       @db.Uuid
  similarity     Float
  created_at     DateTime?    @default(now()) @db.Timestamptz(6)
  media_assets   media_assets @relation(fields: [media_asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  media_faces    media_faces  @relation(fields: [media_face_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([media_face_id, user_id], map: "media_matches_face_user_key")
  @@index([user_id, media_asset_id], map: "idx_media_matches_user_asset")
  @@index([media_asset_id], map: "idx_media_matches_asset")
}

