  @@index([created_at], map: "idx_posts_created_at")
  @@index([user_id], map: "idx_posts_user_id")
}

model roles {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  description String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
