  user_id     String    @db.Uuid
  otp         String    @db.VarChar(6)
  expires_at  DateTime  @db.Timestamptz(6)
  is_verified Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_otp_user")

  @@index([user_id], map: "idx_user_otps_user_id")
}

model users {
  id                                                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name                                            String                  @db.VarChar(100)
  country_code                                         String?                 @db.VarChar(100)
  email                                                String                  @unique @db.VarChar(150)
  password_hash                                        String
  role_id                                              Int
  is_active                                            Boolean?                @default(true)
  created_at                                           DateTime?               @default(now()) @db.Timestamp(6)
  updated_at                                           DateTime?               @default(now()) @db.Timestamp(6)
  avatar_url                                           String?
  mobile_number                                        String?                 @db.VarChar(20)
  instagram_id                                         String?
  comments                                             comments[]
  event_admins_event_admins_assigned_byTousers         event_admins[]          @relation("event_admins_assigned_byTousers")
  event_admins_event_admins_user_idTousers             event_admins[]          @relation("event_admins_user_idTousers")
  event_categories                                     event_categories[]
  event_day_media                                      event_day_media[]
  event_guests_event_guests_invited_byTousers          event_guests[]          @relation("event_guests_invited_byTousers")
  event_guests_event_guests_user_idTousers             event_guests[]          @relation("event_guests_user_idTousers")
  event_offering_master                                event_offering_master[]
  event_offerings                                      event_offerings[]
  event_organizers                                     event_organizers[]
  events                                               events[]
  events_admin                                         events_admin[]
  notifications_notifications_recipient_user_idTousers notifications[]         @relation("notifications_recipient_user_idTousers")
  notifications_notifications_sender_user_idTousers    notifications[]         @relation("notifications_sender_user_idTousers")
  post_likes                                           post_likes[]
  posts                                                posts[]
  user_devices                                         user_devices[]
  user_otps                                            user_otps[]
  user_favorites                                       user_favorites[]
  user_face_references                                 user_face_references?
  media_matches                                        media_matches[]
  media_assets                                         media_assets[]
  roles                                                roles                   @relation(fields: [role_id], references: [id], onUpdate: NoAction)

  @@index([role_id], map: "idx_users_role_id")
}

model venue_contacts {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id     String?        @db.Uuid
  name         String         @db.VarChar(255)
  image_url    String?
  phone_number String?        @db.VarChar(20)
  email        String?        @db.VarChar(255)
  role         String?        @db.VarChar(255)
  is_primary   Boolean?
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  event_guests event_guests[]
  venues       venues?        @relation(fields: [venue_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([venue_id], map: "idx_venue_contacts_venue_id")
}

model venue_facilities {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id   String?   @db.Uuid
  name       String    @db.VarChar(255)
  image_url  String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  venues     venues?   @relation(fields: [venue_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([venue_id], map: "idx_venue_facilities_venue_id")
}

model venue_photos {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id   String?   @db.Uuid
  image_url  String
  alt_text   String?   @db.VarChar(255)
  sort_order Int?      @default(0)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  venues     venues?   @relation(fields: [venue_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([venue_id], map: "idx_venue_photos_venue_id")
}

/// Named areas or halls under a main venue (title + description only).
